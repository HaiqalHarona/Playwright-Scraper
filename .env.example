# DO NOT TOUCH THIS CRUCIAL FOR SCALABILITY
# PROXY SETTINGS
# Optional HTTP/HTTPS proxy URL for routing traffic
# Leave empty if not using a proxy
# Example: http://username:password@proxy-server:port
PROXY_URL=

# STORE CONFIGURATION
# The e-commerce platform to target
# Currently supported: Lazada
STORE_NAME=Lazada

# BOT ACTION MODE
# Determines what the bot will do
# Options:
#   - buy: Automated purchasing mode (sniper) — buys a specific product URL
#   - scrape: Product monitoring/data collection mode — scans a category page
#   - buy_scrape: Scrape then buy — scans a category page for in-stock products,
#                 then automatically purchases each matching product found
ACTION=buy_scrape

# ============================================
# SCRAPER CONFIGURATION
# ============================================
# These settings apply when ACTION=scrape or ACTION=buy_scrape

# SCRAPER STORE NAME
# The store to scrape (can be different from STORE_NAME for buy mode)
# Currently supported: Lazada
# Default: Uses STORE_NAME if not specified
SCRAPER_STORE_NAME=Lazada

# SCRAPER TARGET URL
# The URL to scrape for products (e.g., category page, search results)
# Example: https://www.lazada.sg/shop-laptops/
SCRAPER_TARGET_URL=https://www.lazada.sg/shop-laptops/

# SCRAPER PRODUCT NAMES
# Comma-separated list of product names to continuously monitor for stock
# The scraper will check if these products are in stock
# Leave empty to scrape all products on the page
# Example: iPhone 15 Pro,Samsung Galaxy S24,MacBook Pro M3
SCRAPER_PRODUCT_NAMES=Glass Condiment Container Kitchen Seasoning Box Spice Jar Condiment Jar with Spoon and Lid Airtight Cap Salt Sugar Spice Storage Container,  2pcs Self Adhesive Broom and Mop Grippers Wall Mounted Broom Holders Bathroom Storage Organizer Tool Hanger Dustpan Hanger, 
Mouse Pad with Wrist Support Ergonomic Gaming Mouse Pad with Gel Wrist Rest Mousepad for Computer Laptop

# SCRAPER DELAY (seconds)
# Delay between each product detail page check to avoid rate limiting/CAPTCHA
# Recommended: 1.5-3 seconds (lower = faster but higher risk of CAPTCHA)
# Default: 1.5
SCRAPER_DELAY=1.5

# SCRAPER RANDOM DELAY
# Add random variation to scraper delay to appear more human-like
# Options: true or false
# Default: true
SCRAPER_RANDOM_DELAY=true

# SCRAPER SCROLL COUNT
# Number of times to scroll down on listing pages to load lazy-loaded products
# Higher values load more products but take longer
# Default: 5
SCRAPER_SCROLL_COUNT=3

# SCRAPER CONTINUOUS MODE
# Keep scraping continuously in a loop
# Options: true or false
# Default: false (scrape once and exit)
SCRAPER_CONTINUOUS_MODE=true

# SCRAPER LOOP INTERVAL (seconds)
# Time to wait between scraping cycles when SCRAPER_CONTINUOUS_MODE=true
# Recommended: 300-600 seconds (5-10 minutes)
# Default: 300
SCRAPER_LOOP_INTERVAL=30

# SCRAPER MAX PAGES
# Maximum number of pagination pages to scrape
# Set to 0 for unlimited (scrape all pages)
# Default: 0 (unlimited)
SCRAPER_MAX_PAGES=0

# PURCHASE QUANTITY
# Number of items to add to cart and purchase
# Default: 1
# Note: Some products may have quantity limits
# For buy_scrape mode, this applies to each in-stock product found
TARGET_QUANTITY=1

# RELEASE TIME CONFIGURATION
# Controls when the bot starts executing
# Options:
#   - Leave empty: Execute immediately when bot starts
#   - "test" or "TEST": Set release time to 2 minutes from current time (for testing)
#   - Specific datetime: Use format "YYYY-MM-DD HH:MM:SS" (24-hour format)
# Examples:
#   RELEASE_TIME=
#   RELEASE_TIME=test
#   RELEASE_TIME=2026-05-20 19:45:00
RELEASE_TIME=

# REFRESH TIMING
# Number of seconds before release time to start refreshing the product page
# This ensures the bot is ready when the product drops
# Default: 5 seconds
# Recommended: 3-10 seconds (lower = faster but more aggressive)
REFRESH_LEAD_SECONDS=5

# TEST REFRESH DURATION
# For testing purposes only - keeps refreshing even when product is in stock
# Set to 0 for normal operation
# Set to number of seconds to continue refreshing after finding stock
# Default: 0 (disabled)
TEST_REFRESH_DURATION=0

# ============================================
# ACCOUNT CONFIGURATIONS
# ============================================
# Configure multiple accounts for parallel execution
# Each account will run in its own browser window simultaneously
# You can add as many accounts as needed (ACCOUNT_1, ACCOUNT_2, ACCOUNT_3, etc.)
#
# NOTE for buy_scrape mode:
#   - ACCOUNT_X_URL is optional (ignored) — the scrape target comes from SCRAPER_TARGET_URL
#   - ACCOUNT_X_EMAIL and ACCOUNT_X_PASSWORD are still required for login
#   - Each account independently scrapes and buys from the same SCRAPER_TARGET_URL

# ACCOUNT 1 CONFIGURATION
# The product URL to target for this account
# Must be a valid product page URL from the configured store
# (Not required for buy_scrape mode — uses SCRAPER_TARGET_URL instead)
ACCOUNT_1_URL=https://www.lazada.sg/products/mitsumotosakari-handcrafted-forged-butchering-knife-i3554150446-s23467339416.html?

# Login email for this account
# The bot will attempt auto-login with these credentials
# If auto-login fails (CAPTCHA, slider, etc.), manual login will be required
ACCOUNT_1_EMAIL=your_email_1@example.com

# Login password for this account
# Keep this secure and never commit the actual .env file to version control
ACCOUNT_1_PASSWORD=your_password_1

# ACCOUNT 2 CONFIGURATION
# Second account for parallel execution (optional)
# Remove or comment out if not needed
ACCOUNT_2_URL=https://www.lazada.sg/products/mitsumotosakari-handcrafted-forged-butchering-knife-i3554150446-s23467339416.html?
ACCOUNT_2_EMAIL=your_email_2@example.com
ACCOUNT_2_PASSWORD=your_password_2

# ACCOUNT 3 CONFIGURATION
# Third account for parallel execution (optional)
# Remove or comment out if not needed
ACCOUNT_3_URL=https://www.lazada.sg/products/mitsumotosakari-handcrafted-forged-butchering-knife-i3554150446-s23467339416.html?
ACCOUNT_3_EMAIL=your_email_3@example.com
ACCOUNT_3_PASSWORD=your_password_3

# ============================================
# ADDING MORE ACCOUNTS
# ============================================
# To add more accounts, follow this pattern:
# ACCOUNT_4_URL=https://www.lazada.sg/products/your-product-url
# ACCOUNT_4_EMAIL=your_email_4@example.com
# ACCOUNT_4_PASSWORD=your_password_4
#
# Continue with ACCOUNT_5, ACCOUNT_6, etc. as needed
