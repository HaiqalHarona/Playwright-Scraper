# DO NOT TOUCH THIS CRUCIAL FOR SCALABILITY
# PROXY SETTINGS
# Optional HTTP/HTTPS proxy URL for routing traffic
# Leave empty if not using a proxy
# Example: http://username:password@proxy-server:port
PROXY_URL=

# STORE CONFIGURATION
# The e-commerce platform to target
# Currently supported: Lazada
STORE_NAME=Lazada

# BOT ACTION MODE
# Determines what the bot will do
# Options:
#   - buy: Automated purchasing mode (sniper)
#   - scrape: Product monitoring/data collection mode
ACTION=buy

# PURCHASE QUANTITY
# Number of items to add to cart and purchase
# Default: 1
# Note: Some products may have quantity limits
TARGET_QUANTITY=1

# RELEASE TIME CONFIGURATION
# Controls when the bot starts executing
# Options:
#   - Leave empty: Execute immediately when bot starts
#   - "test" or "TEST": Set release time to 2 minutes from current time (for testing)
#   - Specific datetime: Use format "YYYY-MM-DD HH:MM:SS" (24-hour format)
# Examples:
#   RELEASE_TIME=
#   RELEASE_TIME=test
#   RELEASE_TIME=2026-05-20 19:45:00
RELEASE_TIME=

# REFRESH TIMING
# Number of seconds before release time to start refreshing the product page
# This ensures the bot is ready when the product drops
# Default: 5 seconds
# Recommended: 3-10 seconds (lower = faster but more aggressive)
REFRESH_LEAD_SECONDS=5

# TEST REFRESH DURATION
# For testing purposes only - keeps refreshing even when product is in stock
# Set to 0 for normal operation
# Set to number of seconds to continue refreshing after finding stock
# Default: 0 (disabled)
TEST_REFRESH_DURATION=0

# ============================================
# ACCOUNT CONFIGURATIONS
# ============================================
# Configure multiple accounts for parallel execution
# Each account will run in its own browser window simultaneously
# You can add as many accounts as needed (ACCOUNT_1, ACCOUNT_2, ACCOUNT_3, etc.)

# ACCOUNT 1 CONFIGURATION
# The product URL to target for this account
# Must be a valid product page URL from the configured store
ACCOUNT_1_URL=https://www.lazada.sg/products/mitsumotosakari-handcrafted-forged-butchering-knife-i3554150446-s23467339416.html?

# Login email for this account
# The bot will attempt auto-login with these credentials
# If auto-login fails (CAPTCHA, slider, etc.), manual login will be required
ACCOUNT_1_EMAIL=your_email_1@example.com

# Login password for this account
# Keep this secure and never commit the actual .env file to version control
ACCOUNT_1_PASSWORD=your_password_1

# ACCOUNT 2 CONFIGURATION
# Second account for parallel execution (optional)
# Remove or comment out if not needed
ACCOUNT_2_URL=https://www.lazada.sg/products/mitsumotosakari-handcrafted-forged-butchering-knife-i3554150446-s23467339416.html?
ACCOUNT_2_EMAIL=your_email_2@example.com
ACCOUNT_2_PASSWORD=your_password_2

# ACCOUNT 3 CONFIGURATION
# Third account for parallel execution (optional)
# Remove or comment out if not needed
ACCOUNT_3_URL=https://www.lazada.sg/products/mitsumotosakari-handcrafted-forged-butchering-knife-i3554150446-s23467339416.html?
ACCOUNT_3_EMAIL=your_email_3@example.com
ACCOUNT_3_PASSWORD=your_password_3

# ============================================
# ADDING MORE ACCOUNTS
# ============================================
# To add more accounts, follow this pattern:
# ACCOUNT_4_URL=https://www.lazada.sg/products/your-product-url
# ACCOUNT_4_EMAIL=your_email_4@example.com
# ACCOUNT_4_PASSWORD=your_password_4
#
# Continue with ACCOUNT_5, ACCOUNT_6, etc. as needed
